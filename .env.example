# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="file:./dev.db"

# Meta WhatsApp Cloud API credentials
# Get these from the Meta Developer Dashboard: https://developers.facebook.com/apps/
WHATSAPP_TOKEN="your_whatsapp_access_token_here"
PHONE_NUMBER_ID="your_phone_number_id_here"
WABA_ID="your_whatsapp_business_account_id_here"

# Webhook verification token (you create this, any random string)
WEBHOOK_VERIFY_TOKEN="your_custom_verify_token_here"

# URL of your app for cron jobs (optional, e.g. https://your-app.vercel.app)
APP_URL="http://localhost:3000"
